<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.1.0</Version>
    <Author>Shikaare</Author>
    <Authors>Shikaare</Authors>
    <Description>Preview and batch transmute selected materia with Mutamix.</Description>
    <AssemblyName>MutaMaxxing</AssemblyName>
    <RootNamespace>MutaMaxxing</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <TargetPlatformMoniker>Windows,Version=7.0</TargetPlatformMoniker>
    <TargetPlatformDisplayName>Windows</TargetPlatformDisplayName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="MutaMaxxing.Core\MutaMaxxing.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="MutaMaxxing.Core\**\*.cs" />
    <Compile Remove="MutaMaxxing.Core.Tests\**\*.cs" />
  </ItemGroup>
</Project>
